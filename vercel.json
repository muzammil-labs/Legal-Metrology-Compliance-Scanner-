{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(?!assets/|.*\\.(?:js|css|png|ico|webmanifest|json)$).*",
      "destination": "/index.html"
    }
  ]
}
