{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/server.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server.py" },
    { "source": "/health", "destination": "/api/server.py" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
